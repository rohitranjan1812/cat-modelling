{
  "$defs": {
    "Curve": {
      "additionalProperties": false,
      "properties": {
        "beta": {
          "description": "Lognormal dispersion of the MDR curve",
          "exclusiveMinimum": 0,
          "maximum": 3,
          "title": "Beta",
          "type": "number"
        },
        "theta": {
          "description": "Intensity at which MDR = 50%",
          "exclusiveMinimum": 0,
          "title": "Theta",
          "type": "number"
        }
      },
      "required": [
        "theta",
        "beta"
      ],
      "title": "Curve",
      "type": "object"
    },
    "DamageCorrelationConfig": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "default": "fft",
          "title": "Field",
          "type": "string"
        },
        "model": {
          "default": "one_factor",
          "description": "independent | one_factor | spatial",
          "title": "Model",
          "type": "string"
        },
        "range_km": {
          "default": 10.0,
          "exclusiveMinimum": 0,
          "title": "Range Km",
          "type": "number"
        },
        "rho": {
          "default": 0.15,
          "maximum": 1,
          "minimum": 0,
          "title": "Rho",
          "type": "number"
        },
        "rho_by_construction": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Rho By Construction",
          "type": "object"
        }
      },
      "title": "DamageCorrelationConfig",
      "type": "object"
    },
    "EqConfig": {
      "additionalProperties": false,
      "properties": {
        "area_sites": {
          "default": 12,
          "maximum": 500,
          "minimum": 1,
          "title": "Area Sites",
          "type": "integer"
