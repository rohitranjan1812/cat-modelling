      "title": "EqConfig",
      "type": "object"
    },
    "EqSource": {
      "additionalProperties": false,
      "properties": {
        "b_value": {
          "default": 0.9,
          "exclusiveMaximum": 2.0,
          "exclusiveMinimum": 0.3,
          "title": "B Value",
          "type": "number"
