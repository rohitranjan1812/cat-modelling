          "exclusiveMinimum": 0.01,
          "maximum": 1.0,
          "title": "Dm",
          "type": "number"
        },
        "field": {
          "$ref": "#/$defs/FieldConfig",
          "default": {
            "grid_km": null,
            "model": "fft",
            "range_km": 20.0
          }
        },
        "gmm": {
          "$ref": "#/$defs/GmmCoefficients",
          "default": {
            "a": 0.893,
            "b": 0.715,
            "c": -0.155,
            "d": 0.004,
            "h": 6.0,
            "m_sat": 8.3,
            "s": -0.5
          }
        },
        "max_distance_km": {
          "default": 300.0,
          "exclusiveMinimum": 0,
          "title": "Max Distance Km",
          "type": "number"
        },
        "min_median_pga": {
          "default": 0.01,
          "description": "Prune sites below this (g)",
          "minimum": 0,
          "title": "Min Median Pga",
          "type": "number"
        },
        "phi": {
          "default": 0.55,
          "minimum": 0,
          "title": "Phi",
          "type": "number"
        },
        "position_step_km": {
          "default": 15.0,
          "exclusiveMinimum": 1,
          "title": "Position Step Km",
          "type": "number"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/EqSource"
